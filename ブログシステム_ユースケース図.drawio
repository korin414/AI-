      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- アクター -->
        <mxCell id="guest" value="一般ユーザー&#xa;（未ログイン）" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;whiteSpace=wrap;" vertex="1" parent="1">
